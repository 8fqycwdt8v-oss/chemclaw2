# chemclaw2 environment variables
#
# Copy to .env and fill in. `docker compose up` and the test suite both
# read `.env` automatically. Production secrets live in `fly secrets set …`
# rather than this file.

# ── Required ─────────────────────────────────────────────────────────────────

# Postgres connection. Schemes accepted: postgresql://, postgresql+asyncpg://.
# The app rewrites the former to the latter at startup. Must be a Postgres
# instance with pgvector installed (CI uses pgvector/pgvector:pg16).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chemclaw2

# Anthropic — the agent runtime (Claude Agent SDK). Required.
ANTHROPIC_API_KEY=sk-ant-…

# OpenAI — text-embedding-3-small for paper-chunk / wiki embeddings.
# Required. (Anthropic doesn't ship an embeddings endpoint at the time
# of writing; OpenAI is the off-the-shelf choice per CLAUDE.md.)
OPENAI_API_KEY=sk-…

# Microsoft Entra ID (Azure AD) JWT verification. The Streamlit frontend
# logs the user in (MSAL) and forwards an access token whose audience is
# this backend; the backend validates signature/issuer/audience against the
# tenant's public JWKS and enforces the AD-group gate via the app role below.
#
# AZURE_TENANT_ID         — tenant (directory) GUID. JWKS + issuer derive from it:
#                           JWKS   = https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
#                           issuer = https://login.microsoftonline.com/<tenant>/v2.0
# AZURE_BACKEND_CLIENT_ID — the backend app registration's Application (client)
#                           id. This is the expected token `aud`. The backend
#                           app must set accessTokenAcceptedVersion=2 so tokens
#                           carry the v2.0 issuer above.
# AZURE_REQUIRED_ROLE     — app role value (e.g. "chemclaw.user") that gates
#                           access. Assign your AD security group to this app
#                           role on the backend app registration, and set
#                           "Assignment required = Yes" on the enterprise app so
#                           Entra refuses to mint a token for non-members.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_BACKEND_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_REQUIRED_ROLE=chemclaw.user

# Comma-separated list of Entra user `oid` (object id) values that get admin
# routes. Empty in this file so dev defaults to "no admins"; populate to
# enable admin in dev. Production sets this via fly secrets.
ADMIN_USER_IDS=

# ── Environment marker ───────────────────────────────────────────────────────

# Affects auth (ALLOW_MOCK_AUTH only accepted in dev/test/local), CORS
# (prod refuses empty/wildcard/localhost origins), and log format defaults.
# Accepted values: dev, development, test, local, prod, production.
ENV=dev

# ── Optional but recommended ─────────────────────────────────────────────────

# Dev-only Entra bypass. Sets `Bearer mock:<user_id>` as a valid token.
# Refused at startup when ENV is not in {dev, development, test, local}.
ALLOW_MOCK_AUTH=0

# Comma-separated allowed CORS origins. Empty/wildcard/localhost is
# refused at startup when ENV is prod/production (CLAUDE.md security
# fails-closed gate). In dev the defaults are localhost:3000 + :5173.
CORS_ALLOWED_ORIGINS=

# Structured logging. "json" for prod log aggregators (Fly / Datadog /
# CloudWatch); "plain" for local dev.
LOG_FORMAT=plain
LOG_LEVEL=INFO

# Database connection pool. Total = DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW.
# Must stay under Postgres `max_connections / replica_count`. Defaults
# (5 + 10 = 15) match the original Wave-3h baseline.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# Run the fp_worker + campaign_worker inside the FastAPI process. Set to
# "0" (default) in production and spawn them as separate Fly processes
# instead (see fly.toml [processes] worker). "1" is for local dev.
RUN_WORKER_IN_PROCESS=0

# Service-token mode for the GUI→backend path. HMAC-SHA256 signed token
# with the prefix `svc.`. Disabled when unset.
CHEMCLAW2_SERVICE_SECRET=

# ── Agent surface (optional features) ────────────────────────────────────────

# ELN integration. ELN_API_BASE_URL must be on ALLOWED_DOMAINS for the
# fetch path to clear the SSRF guard.
ELN_API_BASE_URL=
ELN_API_KEY=
ELN_WEBHOOK_SECRET=

# SharePoint / OneDrive drive sync via Microsoft Graph (app-only OAuth).
# All four required for the sync connector; unset → the connector no-ops.
# Set up an Entra (Azure AD) app registration with admin-consented Graph
# application permissions Sites.Read.All + Files.Read.All. See
# docs/plans/sharepoint-drive-sync.md §4 for the exact steps and how to
# find the drive id. graph.microsoft.com + sharepoint.com are on
# ALLOWED_DOMAINS so the data calls clear the SSRF guard.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_DRIVE_ID=

# Reaction-condition scoring provider. anthropic (default) or openai.
RCS_PROVIDER=anthropic
ANTHROPIC_RCS_MODEL=claude-haiku-4-5-20251001
OPENAI_RCS_MODEL=gpt-5o-mini
ENTITY_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Max characters of a document fed to the LLM entity-extraction pass in
# `extract='full'` ingestion. Bounds token cost on long documents; default
# 40000 (~10k tokens) so whole papers are analysed, not just the first ~8 KB.
ENTITY_EXTRACTION_MAX_CHARS=40000

# Document-ingestion chunk sizing. Validated by `_resolve_chunk_params`
# with fallback to defaults (400 / 80) on misconfig.
PAPER_CHUNK_SIZE=400
PAPER_CHUNK_OVERLAP=80

# Bayesian-optimisation gate. Fewer than BO_MIN_DATAPOINTS completed
# campaign outcomes → propose_next_conditions falls back to heuristic
# / LHS stages.
BO_MIN_DATAPOINTS=10

# Brave Search API for the agent's web_search tool. Disabled when unset.
BRAVE_SEARCH_API_KEY=

# AiZynthFinder (deep retrosynthesis). Default downloads ~500 MB of
# demo models on first call; set this to point at a pre-staged bundle
# for production-grade route discovery.
AIZYNTH_CONFIG_PATH=

# IBM RXN for Chemistry — optional.
RXN_API_KEY=
RXN_MODEL_VERSION=
RXN_PROJECT_ID=

# MCP subprocess log verbosity. DEBUG / INFO / WARNING.
MCP_LOG_LEVEL=WARNING
