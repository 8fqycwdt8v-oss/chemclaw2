# Copy to .streamlit/secrets.toml and fill in. Do NOT commit secrets.toml.
#
# These come from two Microsoft Entra app registrations (see frontend/README.md):
#   • the FRONTEND app registration (this Streamlit app) — a confidential web
#     client with a client secret and a redirect URI;
#   • the BACKEND app registration (the FastAPI API) — exposes the
#     "access_as_user" delegated scope and owns the app role used to gate access.

[azure]
tenant_id            = "00000000-0000-0000-0000-000000000000"
frontend_client_id   = "00000000-0000-0000-0000-000000000000"
frontend_client_secret = "your-frontend-app-client-secret"
# The BACKEND app's Application (client) id. We request the scope
# api://<backend_client_id>/access_as_user so the token's audience is the API.
backend_client_id    = "00000000-0000-0000-0000-000000000000"
# Must exactly match a redirect URI registered on the FRONTEND app
# (type: Web). For local dev this is the Streamlit URL.
redirect_uri         = "http://localhost:8501"

[backend]
api_url = "http://localhost:8080"
